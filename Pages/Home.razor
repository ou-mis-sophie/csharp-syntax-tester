@page "/"
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@using Basic.Reference.Assemblies

<PageTitle>C# Syntax Tester</PageTitle>

<main class="page-shell">
    <section class="card">
        <div class="header-row">
            <div>
                <h1>C# Syntax Tester</h1>
                <p class="subtitle">
                    Checks C# syntax only. No AI, autocomplete, debugging hints, or code execution.
                </p>
            </div>
            <span class="local-badge">Runs locally in your browser</span>
        </div>

        <label class="editor-label" for="codeEditor">C# code</label>

        <textarea id="codeEditor"
                  class="code-editor"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  @bind="Code"
                  @bind:event="oninput"></textarea>

        <div class="button-row">
            <button class="primary" @onclick="CheckSyntax">Check Syntax</button>
            <button class="secondary" @onclick="Reset">Reset</button>
            <button class="secondary" @onclick="Clear">Clear</button>
        </div>

        <section class="result-panel @ResultClass" aria-live="polite">
            <div class="result-title">Result</div>
            <div class="result-message">@ResultMessage</div>
        </section>

        <p class="privacy-note">
            Your code stays in this browser tab.
            This page does not send student code to a server.
        </p>
    </section>
</main>

@code {
    private const string StarterCode = @"using System;
using System.Collections.Generic;

string[] courses = { ""MIS 3013"", ""MIS 3033"", ""MIS 3353"" };
List<string> assignments = new List<string>();

// PLEASE KEEP THE LINES ABOVE UNCHANGED
// PLEASE WRITE YOUR CODE BETWEEN THE FOLLOWING PSEUDOCODE.


// Option 2: Update Course Array
// If the array is empty, direct the user to Option 1. 
// Otherwise display courses,
// request an index, 
// validate bounds,
// replace the selected course, and 
// display the updated array.


// Option 4: Update Assignment List 
// Display current assignments with index,
// request a valid index,
// replace the List item, and 
// display the updated List. 
// If the old name exists as a Dictionary key, move its existing value to the new key.


";

    private string Code { get; set; } = StarterCode;
    private string ResultMessage { get; set; } = "Ready.";
    private string ResultClass { get; set; } = "neutral";

    private void CheckSyntax()
{
    if (string.IsNullOrWhiteSpace(Code))
    {
        ResultMessage = "Enter C# code before checking.";
        ResultClass = "neutral";
        return;
    }

    try
    {
        var syntaxTree = CSharpSyntaxTree.ParseText(
            Code,
            new CSharpParseOptions(LanguageVersion.Latest)
        );

        var compilation = CSharpCompilation.Create(
            "StudentCode",
            new[] { syntaxTree },
            Basic.Reference.Assemblies.Net80.References.All,
            new CSharpCompilationOptions(
                OutputKind.ConsoleApplication
            )
        );

        var hasErrors = compilation
            .GetDiagnostics()
            .Any(d =>
                d.Severity == DiagnosticSeverity.Error
            );

        if (hasErrors)
        {
            ResultMessage =
                "Code error detected. Review your code and try again.";

            ResultClass = "error";
        }
        else
        {
            ResultMessage = "Code OK.";
            ResultClass = "success";
        }
    }
    catch
    {
        ResultMessage =
            "Unable to check code. Please try again.";

        ResultClass = "error";
    }
}

    private void Reset()
    {
        Code = StarterCode;
        ResultMessage = "Ready.";
        ResultClass = "neutral";
    }

    private void Clear()
    {
        Code = string.Empty;
        ResultMessage = "Ready.";
        ResultClass = "neutral";
    }
}
